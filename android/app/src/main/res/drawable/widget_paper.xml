<?xml version="1.0" encoding="utf-8"?>
<!--
    홈 화면 위젯 종이 (대형). 학습 달력 일기장(DiaryPage.dart)의 _paper, _paperEdge 와 같은 계열이다.
    값은 docs/홈 화면 위젯/위젯_데이터_계약.md 의 디자인 토큰을 그대로 쓴다.
    대형은 달력이 공책 줄과 겹쳐 어지러워서 줄 없이 둔다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFCF5" />
    <stroke android:width="1dp" android:color="#F0E7D6" />
    <corners android:radius="28dp" />
</shape>
